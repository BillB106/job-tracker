# Copy to .env for local dev, or set these as environment variables in Railway/Render.

# Password to log into the web UI (REQUIRED — change this!)
APP_PASSWORD=change-me-to-something-strong

# Secret used to sign the session cookie. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database. Leave unset for local dev (uses a local SQLite file ./jobs.db).
# In production, Railway/Render provide this automatically when you add Postgres.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Cookie security: "auto" (default) sets Secure cookies when served over HTTPS.
# COOKIE_SECURE=auto
